# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://mcnamer.com

# --- Contact form delivery (server-only) ---
# Resend API key. Get one at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender on your domain, e.g. "McNamer.com <website@mcnamer.com>"
CONTACT_FROM_EMAIL=
# Where inbound enquiries are delivered
CONTACT_TO_EMAIL=jody@mcnamer.com

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=
