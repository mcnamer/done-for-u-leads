# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://doneforuleads.com

# --- Contact form delivery (server-only) ---
# Resend API key. Get one at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender on your domain, e.g. "Done For You Leads <website@doneforuleads.com>"
CONTACT_FROM_EMAIL=
# Where inbound enquiries are delivered. Unset falls back to the address in src/content/site.ts.
CONTACT_TO_EMAIL=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=

# Client portal — WordPress REST backend.
# Unset uses the baked-in default in src/lib/portal/api.ts (the temp Bluehost URL).
# Set this once WordPress moves to its final domain.
WP_API_URL=
